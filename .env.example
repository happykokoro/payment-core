HOST=127.0.0.1
PORT=4004
# Optional separate crypto-payment-ui checkout URL. Leave empty for API-only use.
CHECKOUT_URL=http://127.0.0.1:4006/checkout/
DATABASE_URL=postgresql://payments:payments@127.0.0.1:5432/payments
# Run npm run keys; paste three different generated values below.
API_KEY=
TOKEN_SECRET=
# Planned rotation: put the old TOKEN_SECRET in this JSON array, then set a new TOKEN_SECRET.
# Retain keys needed by live vouchers; use the API to revoke compromised keys and reissue credentials.
TOKEN_SECRET_PREVIOUS=[]
WEBHOOK_SECRET=
WEBHOOK_URL=http://127.0.0.1:4005/events
# Base Sepolia is the default. Mainnet also requires ALLOW_MAINNET=true.
PAYMENT_NETWORK=base-sepolia
ALLOW_MAINNET=false
RPC_URL=https://sepolia.base.org
# Fresh addresses controlled by YOUR wallet, comma-separated. No private keys.
# Every invoice permanently reserves one address; used addresses are never recycled.
RECEIVE_ADDRESSES=
POLL_INTERVAL_MS=5000
# Base's public testnet RPC allows at most 200 blocks per log query.
SCAN_BLOCK_RANGE=200
INVOICE_BATCH_SIZE=20
LATE_PAYMENT_WINDOW_SECONDS=604800
WEBHOOK_MAX_ATTEMPTS=8
HEALTH_STALE_SECONDS=120
HEALTH_SCAN_LAG_BLOCKS=2000
HEALTH_WEBHOOK_AGE_SECONDS=300
ADDRESS_POOL_LOW=5
# Optional durable merchant example; use a SEPARATE database from the core.
# MERCHANT_DATABASE_URL=postgresql://merchant:password@127.0.0.1:5432/merchant
# WEBHOOK_SECRET_PREVIOUS=old-secret-during-webhook-rotation
